<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">



    <EditText
        android:hint="Enter your word"
        android:id="@+id/edit_word"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <EditText
        android:id="@+id/edit_meaning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/edit_word"
        android:layout_alignParentStart="true"
        android:layout_marginTop="10dp"
        android:hint="Enter the meaning" />

    <android.support.v7.widget.AppCompatImageButton
        android:id="@+id/btnAddSentences"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/edit_meaning"
        android:layout_marginTop="10dp"
        android:layout_alignParentLeft="true"
        android:background="@drawable/ic_note_add_custom_48dp" />

</RelativeLayout>