<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/layoutListem">
    <View
        android:layout_width="12dp"
        android:layout_height="65dp"
        android:background="@color/colorSideDivider"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:layout_marginLeft="12dp">

        <TextView
            android:id="@+id/wordField"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ic_launcher"
            android:text="Word Field"
            android:textColor="#2F74AA"
            android:textSize="18dp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/meaningField"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/wordField"
            android:layout_alignStart="@+id/wordField"
            android:layout_marginTop="2dp"
            android:textStyle="italic"
            android:text="word meaning"
            android:textColor="#000"
            android:textSize="14dp" />

        <TextView
            android:id="@+id/getDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@+id/wordField"
            android:layout_marginStart="19dp"
            android:layout_toEndOf="@+id/wordField"
            android:text="TextView"
            android:textSize="8dp"
            android:textStyle="italic" />
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnAddSentences"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ic_note_add_custom_48dp"
            android:layout_alignParentRight="true"/>


    </RelativeLayout>

</RelativeLayout>